# Environment files. Symfony convention: `backend/.env` holds non-secret defaults and
# IS committed, because SymfonyRuntime::bootEnv() cannot boot without it. Real secrets
# live in `.env.local` and `.env.*.local`, which are never committed.
.env
.env.local
.env.*.local
!/backend/.env

# TLS certificates (generate locally, never commit)
certs/

# Backend
backend/vendor/
backend/var/

# Frontend
frontend/node_modules/
frontend/dist/

# Playwright test artifacts
frontend/test-results/
frontend/playwright-report/

# Local SDD config (engram project registration)
.engram/

# Agent tool registry (machine-generated, environment-specific)
.atl/
.codegraph/
.pi/
